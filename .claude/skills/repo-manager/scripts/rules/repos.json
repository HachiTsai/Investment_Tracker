      "pyproject": true,
      "rule_file": ".claude/rules/python-environment.md",
      "committer": ".claude/skills/fin-commit/scripts/committer.py",
      "native_env_check": true
    },
    "Remote-Controller": {
      "venv": ".venv",
      "python": "3.12",
      "pyproject": false,
      "rule_file": null,
