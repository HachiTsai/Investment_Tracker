      "venv": "~/.venv",
      "python": "3.14",
      "pyproject": true,
      "rule_file": ".claude/rules/python-environment.md",
      "committer": ".claude/skills/commit-workflow/scripts/committer.py",
      "native_env_check": false
    },
    "Hello-World": {
      "venv": ".venv",
      "python": "3.13",
      "pyproject": true,
      "rule_file": ".claude/rules/python-environment.md",
